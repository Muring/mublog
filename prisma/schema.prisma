generator client {
    provider = "prisma-client-js"
    output   = "../src/generated/prisma"
}

// Prisma 7 부터 접속 URL 은 스키마가 아니라 prisma.config.ts 에 둔다.
// 런타임 접속은 PrismaClient 에 넘기는 드라이버 어댑터(@prisma/adapter-pg)가 담당한다.
datasource db {
    provider = "postgresql"
}

enum Role {
    USER
    ADMIN
}

enum PostStatus {
    DRAFT
    PUBLISHED
}

/// Supabase auth.users 의 미러. on_auth_user_created 트리거가 채운다.
/// auth 스키마는 Supabase 소유이므로 Prisma 관계로 묶지 않는다.
/// FK 와 트리거는 raw SQL 마이그레이션에서 추가해 Prisma Migrate 를 public 에만 가둔다.
model Profile {
    id        String   @id @db.Uuid
    githubId  String?  @unique @map("github_id")
    username  String
    avatarUrl String?  @map("avatar_url")
    role      Role     @default(USER)
    createdAt DateTime @default(now()) @map("created_at")

    posts    Post[]
    comments Comment[]

    @@map("profiles")
}

model Post {
    id          String     @id @default(cuid())
    slug        String     @unique
    title       String
    description String?
    tags        String[]   @default([])
    thumbnail   String?
    /// 편집용 마크다운 원문
    contentMd   String     @map("content_md")
    /// 저장 시점에 렌더된 본문 HTML
    contentHtml String     @map("content_html")
    status      PostStatus @default(DRAFT)
    publishedAt DateTime?  @map("published_at")
    readingTime Int        @default(1) @map("reading_time")
    /// 포스트별 조회수. 컬럼만 확보해두고 증가 로직은 아직 연결하지 않는다.
    viewCount   Int        @default(0) @map("view_count")
    /// 목록 렌더마다 _count 서브쿼리를 돌리지 않으려고 비정규화한다.
    commentCount Int       @default(0) @map("comment_count")
    createdAt   DateTime   @default(now()) @map("created_at")
    updatedAt   DateTime   @updatedAt @map("updated_at")

    /// nullable 인 이유: 인증(Phase 2) 없이 포스트 마이그레이션이 먼저 돌 수 있어야 한다.
    authorId String?  @map("author_id") @db.Uuid
    author   Profile? @relation(fields: [authorId], references: [id], onDelete: SetNull)

    comments Comment[]

    @@index([status, publishedAt(sort: Desc)])
    @@index([tags], type: Gin)
    @@map("posts")
}

model Comment {
    id        String    @id @default(cuid())
    body      String    @db.VarChar(2000)
    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime  @updatedAt @map("updated_at")
    editedAt  DateTime? @map("edited_at")
    /// soft delete. 답글이 고아가 되지 않도록 행은 남기고 API 가 본문을 가린다.
    deletedAt DateTime? @map("deleted_at")

    postId String @map("post_id")
    post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

    authorId String  @map("author_id") @db.Uuid
    author   Profile @relation(fields: [authorId], references: [id], onDelete: Cascade)

    /// 컬럼은 임의 깊이를 허용하지만 API 가 2단으로 제한한다.
    parentId String?   @map("parent_id")
    parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
    replies  Comment[] @relation("CommentReplies")

    @@index([postId, createdAt])
    @@index([authorId, createdAt])
    @@map("comments")
}

/// 사이트 전체 방문 집계. KST 기준 하루 1행.
/// 요청당 행을 남기지 않으므로 연 365행(약 20KB)에 그친다.
/// 총 방문자 = SUM(visitors).
model DailyStat {
    /// 그날의 순 방문자 (쿠키 기준 1일 1회)
    date     DateTime @id @db.Date
    visitors Int      @default(0)

    @@map("daily_stats")
}
