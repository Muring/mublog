{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "regions": [
        "icn1"
    ],
    "ignoreCommand": "git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" \"$VERCEL_GIT_COMMIT_SHA\" -- . ':!backup' ':!output' ':!*.md'",
    "crons": [
        {
            "path": "/api/cron/daily",
            "schedule": "0 3 * * *"
        }
    ]
}
