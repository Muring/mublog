# ─────────────────────────────────────────────────────────────
# Supabase
# 값 위치: 프로젝트 상단 [Connect] 버튼
#   - DATABASE_URL / DIRECT_URL  ->  Connect > ORMs 탭 > Prisma
#   - 키                          ->  Connect > App Frameworks 탭
#
# 주의: Connect > ORMs > Prisma 화면이 같이 보여주는 schema.prisma 예시는 쓰지 않는다.
#       Prisma 7 은 url/directUrl 을 스키마에서 제거했고, 이 저장소는
#       prisma.config.ts + 드라이버 어댑터 방식을 쓴다.
# ─────────────────────────────────────────────────────────────

# 앱 런타임용. 반드시 6543 (Transaction pooler).
# ?pgbouncer=true 를 빼면 동시 요청 시에만 "prepared statement s0 already exists"
# 오류가 간헐적으로 난다 (로컬에서는 재현되지 않고 프로덕션에서만 터진다).
# connection_limit=1 : 서버리스 인스턴스마다 풀이 생기므로 그 이상이면 무료 티어 커넥션이 고갈된다.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# 마이그레이션용. 반드시 5432 (Session pooler).
# db.<ref>.supabase.co:5432 는 IPv6 전용이라 CI 에서 실패하므로 쓰지 않는다.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# 비밀번호에 특수문자가 있으면 URL 인코딩해야 한다.
#   @ -> %40   # -> %23   / -> %2F   ? -> %3F   : -> %3A
# 기억나지 않으면 Project Settings > Database > Reset database password

NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"

# 구 anon key 자리. 클라이언트 번들에 노출되는 것이 정상이다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# 구 service_role key 자리. 서버 전용 - 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것.
# 이미지 업로드에서 Storage 에 쓸 때만 사용한다.
SUPABASE_SECRET_KEY="sb_secret_..."

# OAuth 콜백 URL 구성에 사용
NEXT_PUBLIC_SITE_URL="https://muring-blog.vercel.app"

# Supabase 무료 프로젝트가 7일 무활동으로 정지되는 것을 막는 cron 보호용
CRON_SECRET="<openssl rand -hex 32>"
